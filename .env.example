# Groq API key — transcription and scoring only (app/api/rate/route.ts). Server-side only.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional: pin the Groq chat model used for scoring (default: openai/gpt-oss-120b).
# GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Gemini API key — topic generation only (free tier). Audio and transcripts never go here.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Gemini topic model. Google retires model names often, so this lives in env, never in code.
GEMINI_TOPIC_MODEL=gemini-3.5-flash-lite
